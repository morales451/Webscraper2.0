# Copy this file to .env and fill in what you need. Everything is optional.

# Google Places API key (https://console.cloud.google.com -> APIs -> "Places API (New)").
# When set, searches use the official API. When empty, the free browser scraper is used.
GOOGLE_PLACES_API_KEY=

# Which listing source to use: auto | api | browser
#   auto    -> API if a key is set, otherwise browser
PROSPECTOR_SOURCE=auto

# Show the Chromium window while scraping Google Maps (true/false). Handy for debugging.
PROSPECTOR_HEADLESS=true

# Where the database and exports are stored.
PROSPECTOR_DATA_DIR=data

# Web dashboard address.
PROSPECTOR_HOST=127.0.0.1
PROSPECTOR_PORT=8000

# Keep a persistent Chromium profile in data/browser-profile (true/false). Combine with
# `prospector browser-login` to sign in to Google once so Maps shows review counts.
PROSPECTOR_BROWSER_PROFILE=false

# Use a specific Chromium/Chrome executable instead of Playwright's bundled one (optional).
PROSPECTOR_CHROMIUM_PATH=
